# Job-hunt — copy to .env (gitignored). Server/worker only unless noted.

# --- Core ---
ENVIRONMENT=local
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Auth (API verifies Clerk JWT; never expose secret keys to Vite) ---
AUTH_MODE=clerk
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Local/CI only:
# AUTH_MODE=test
# TEST_JWT_SECRET=change-me-to-32-chars-minimum-secret!!

# --- Encryption for connector tokens (Gmail OAuth refresh tokens) ---
TOKEN_ENCRYPTION_KEY=BASE64_32_BYTE_KEY=
# Optional previous key during rotation (decrypt old, re-encrypt with primary)
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- Supabase (Postgres + optional Storage for CVs/artifacts) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional dedicated storage bucket (service role used only in API/worker)
SUPABASE_STORAGE_BUCKET=candidate-artifacts

# --- Gmail alerts (Phase 3 — optional live; fixtures work without these) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/sources/gmail_alerts/oauth/callback
GMAIL_REDIRECT_ALLOWLIST=http://localhost:8000/api/v1/sources/gmail_alerts/oauth/callback
GMAIL_ALLOWED_LABELS=JobAlerts,Jobs,INBOX/Jobs
OAUTH_STATE_SECRET=
ALLOW_GMAIL_OAUTH_DEV=false
UAT_SIGNOFF_SECRET=
UAT_ADMIN_USER_IDS=
UAT_SIGNOFF_TTL_DAYS=90
WORKER_INTERNAL_URL=http://127.0.0.1:8001
# Server/worker ONLY — never add FEATURE_EXTERNAL_GMAIL to apps/web/.env
FEATURE_EXTERNAL_GMAIL=false
GMAIL_MAX_MESSAGES_PER_INGEST=25

# --- Feature flags ---
FEATURE_US_MARKET=false
FEATURE_LIVE_ATS_HTTP=false
FEATURE_DOCUMENT_DRAFTS=true
FEATURE_GMAIL_ALERTS=true
FEATURE_BROWSER_CAPTURE=true
FEATURE_LINKEDIN_INGEST=true
# Live unrestricted LinkedIn scrape stays off; drop scraper JSON/CSV into LINKEDIN_EXPORT_DIR.
FEATURE_LINKEDIN_SCRAPE=false
LINKEDIN_EXPORT_DIR=data/linkedin-exports

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=120
STRONG_MATCH_THRESHOLD=50

# --- Worker ---
WORKER_POLL_SECONDS=2
WORKER_PORT=8001

# --- Web (copy to apps/web/.env — publishable key ONLY) ---
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_API_BASE=http://127.0.0.1:8000/api/v1
