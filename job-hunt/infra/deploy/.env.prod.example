ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
AUTH_MODE=clerk
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64
FEATURE_US_MARKET=false
FEATURE_LIVE_ATS_HTTP=false
CORS_ORIGINS=https://app.example.com
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE
VITE_API_BASE=/api/v1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE
