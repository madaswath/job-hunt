# =============================================================================
# Job-hunt SaaS — copy to .env and fill in values (never commit real secrets here)
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3800
APP_URL=http://localhost:3000
API_URL=http://localhost:3800
ENTITLEMENTS_MODE=soft
ALLOW_UNAUTH_API=false
DEV_CLERK_USER_ID=dev_local_user

# --- Clerk (https://dashboard.clerk.com) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_API_URL=http://localhost:3800

# --- Supabase (https://supabase.com/dashboard) ---
SUPABASE_URL=https://btinlwtseqtnznublasj.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.btinlwtseqtnznublasj.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# --- Jev (decision layer) ---
# Hosted decide API (matches Python: POST .../api/v1/decide + Bearer JEV_API_KEY):
JEV_API_KEY=
JEV_API_URL=https://jevtypesafeai.com/api/v1/decide
# Optional; omit on /decide to use provider default. Official TypeSafe direct:
# TYPESAFE_API_KEY=  JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=

# --- Groq ---
GROQ_API_KEY=
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_LONG_MODEL=mixtral-8x7b-32768

# --- Razorpay ---
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Optional ---
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
